@tailwind utilities;
@tailwind base;

/* ---------- 테마 토큰 (VS Code Light Modern / Dark Modern 기반) ---------- */
:root {
	color-scheme: light;
	--bg: #ffffff;
	--bg-side: #f8f8f8;
	--bg-activity: #f8f8f8;
	--bg-tabs: #f8f8f8;
	--bg-tab-active: #ffffff;
	--bg-hover: #f0f0f0;
	--bg-selected: #e4ecf6;
	--border: #e5e5e5;
	--text: #1f2328;
	--text-muted: #59636e;
	--text-faint: #8c959f;
	--accent: #005fb8;
	--accent-soft: rgba(0, 95, 184, 0.08);
	--statusbar: #005fb8;
	--statusbar-text: #ffffff;
	--code-bg: #f6f8fa;
	--code-border: #e8eaed;
	--inline-code-bg: rgba(175, 184, 193, 0.2);
	--quote-bg: #f6f8fa;
	--chip-bg: #eef2f7;

	--tok-comment: #008000;
	--tok-keyword: #0000ff;
	--tok-control: #af00db;
	--tok-string: #a31515;
	--tok-number: #098658;
	--tok-function: #795e26;
	--tok-class: #267f99;
	--tok-variable: #001080;
	--tok-punct: #393a34;

	--font-sans: 'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont, 'Segoe UI',
		'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif;
	--font-mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono',
		monospace;
	--activity-w: 48px;
	--panel-w: 260px;
	--tabs-h: 35px;
	--status-h: 22px;
}

@media (prefers-color-scheme: dark) {
	:root:not([data-theme='light']) {
		color-scheme: dark;
		--bg: #1f1f1f;
		--bg-side: #181818;
		--bg-activity: #181818;
		--bg-tabs: #181818;
		--bg-tab-active: #1f1f1f;
		--bg-hover: #2a2d2e;
		--bg-selected: #37373d;
		--border: #2b2b2b;
		--text: #d4d4d4;
		--text-muted: #9d9d9d;
		--text-faint: #6e7681;
		--accent: #4daafc;
		--accent-soft: rgba(77, 170, 252, 0.1);
		--statusbar: #0078d4;
		--statusbar-text: #ffffff;
		--code-bg: #181818;
		--code-border: #2b2b2b;
		--inline-code-bg: rgba(110, 118, 129, 0.35);
		--quote-bg: #252526;
		--chip-bg: #2b2d31;

		--tok-comment: #6a9955;
		--tok-keyword: #569cd6;
		--tok-control: #c586c0;
		--tok-string: #ce9178;
		--tok-number: #b5cea8;
		--tok-function: #dcdcaa;
		--tok-class: #4ec9b0;
		--tok-variable: #9cdcfe;
		--tok-punct: #d4d4d4;
	}
}

:root[data-theme='dark'] {
	color-scheme: dark;
	--bg: #1f1f1f;
	--bg-side: #181818;
	--bg-activity: #181818;
	--bg-tabs: #181818;
	--bg-tab-active: #1f1f1f;
	--bg-hover: #2a2d2e;
	--bg-selected: #37373d;
	--border: #2b2b2b;
	--text: #d4d4d4;
	--text-muted: #9d9d9d;
	--text-faint: #6e7681;
	--accent: #4daafc;
	--accent-soft: rgba(77, 170, 252, 0.1);
	--statusbar: #0078d4;
	--statusbar-text: #ffffff;
	--code-bg: #181818;
	--code-border: #2b2b2b;
	--inline-code-bg: rgba(110, 118, 129, 0.35);
	--quote-bg: #252526;
	--chip-bg: #2b2d31;

	--tok-comment: #6a9955;
	--tok-keyword: #569cd6;
	--tok-control: #c586c0;
	--tok-string: #ce9178;
	--tok-number: #b5cea8;
	--tok-function: #dcdcaa;
	--tok-class: #4ec9b0;
	--tok-variable: #9cdcfe;
	--tok-punct: #d4d4d4;
}

/* ---------- 기본 ---------- */
*,
*::before,
*::after {
	box-sizing: border-box;
}

html,
body {
	margin: 0;
	padding: 0;
	height: 100%;
	background: var(--bg);
	color: var(--text);
	font-family: var(--font-sans);
	font-size: 16px;
	line-height: 1.6;
	-webkit-font-smoothing: antialiased;
	-moz-osx-font-smoothing: grayscale;
}

a {
	color: inherit;
	text-decoration: none;
}

button {
	font: inherit;
	color: inherit;
}

:focus-visible {
	outline: 1px solid var(--accent);
	outline-offset: -1px;
}

/* ---------- 본문 (마크다운) ---------- */
.prose {
	font-size: 17px;
	line-height: 1.8;
	word-break: keep-all;
	overflow-wrap: anywhere;
}

.prose > :first-child {
	margin-top: 0;
}

.prose h1,
.prose h2,
.prose h3,
.prose h4 {
	line-height: 1.35;
	font-weight: 700;
	letter-spacing: -0.01em;
	scroll-margin-top: calc(var(--tabs-h) + 16px);
}

.prose h1 {
	font-size: 1.75rem;
	margin: 2.5rem 0 1rem;
}

.prose h2 {
	font-size: 1.45rem;
	margin: 3rem 0 1rem;
	padding-bottom: 0.4rem;
	border-bottom: 1px solid var(--border);
}

.prose h3 {
	font-size: 1.2rem;
	margin: 2rem 0 0.75rem;
}

.prose p {
	margin: 0 0 1.15rem;
}

.prose a {
	color: var(--accent);
	text-decoration: underline;
	text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
	text-underline-offset: 3px;
}

.prose a:hover {
	text-decoration-color: var(--accent);
}

.prose strong {
	font-weight: 700;
	color: var(--text);
}

.prose ul,
.prose ol {
	margin: 0 0 1.15rem;
	padding-left: 1.4rem;
}

.prose li {
	margin: 0.3rem 0;
}

.prose li::marker {
	color: var(--text-faint);
}

.prose hr {
	border: 0;
	border-top: 1px solid var(--border);
	margin: 2.5rem 0;
}

.prose img {
	max-width: 100%;
	height: auto;
	border-radius: 6px;
}

.prose blockquote {
	margin: 1.5rem 0;
	padding: 0.9rem 1.1rem;
	background: var(--quote-bg);
	border-left: 3px solid var(--accent);
	border-radius: 0 6px 6px 0;
	color: var(--text-muted);
	font-size: 0.95em;
}

.prose blockquote > :last-child {
	margin-bottom: 0;
}

.prose table {
	display: block;
	width: max-content;
	max-width: 100%;
	overflow-x: auto;
	border-collapse: collapse;
	margin: 1.5rem 0;
	font-size: 0.92em;
	line-height: 1.6;
}

.prose th,
.prose td {
	padding: 0.55rem 0.9rem;
	border: 1px solid var(--border);
	text-align: left;
	vertical-align: top;
}

.prose th {
	background: var(--bg-side);
	font-weight: 600;
	white-space: nowrap;
}

.prose :not(pre) > code {
	font-family: var(--font-mono);
	font-size: 0.86em;
	padding: 0.15em 0.4em;
	border-radius: 4px;
	background: var(--inline-code-bg);
	word-break: break-word;
}

.prose pre {
	margin: 1.5rem 0;
	padding: 1rem 1.15rem;
	background: var(--code-bg);
	border: 1px solid var(--code-border);
	border-radius: 6px;
	overflow-x: auto;
	font-size: 14px;
	line-height: 1.65;
}

.prose pre code {
	font-family: var(--font-mono);
	background: none;
	padding: 0;
	white-space: pre;
	word-break: normal;
	overflow-wrap: normal;
	color: var(--text);
}

/* rehype-toc 가 만드는 목차 */
.prose nav.toc {
	margin: 0 0 2.5rem;
	padding: 1rem 1.25rem 0.75rem;
	border: 1px solid var(--border);
	border-radius: 6px;
	background: var(--bg-side);
	font-size: 0.92em;
	line-height: 1.6;
}

.prose nav.toc::before {
	content: '목차';
	display: block;
	margin-bottom: 0.4rem;
	font-size: 0.75rem;
	font-weight: 600;
	letter-spacing: 0.06em;
	color: var(--text-faint);
}

.prose nav.toc ol {
	list-style: none;
	margin: 0;
	padding-left: 0;
}

.prose nav.toc ol ol {
	padding-left: 1rem;
}

.prose nav.toc li {
	margin: 0.2rem 0;
}

.prose nav.toc a {
	color: var(--text-muted);
	text-decoration: none;
}

.prose nav.toc a:hover {
	color: var(--accent);
}

/* ---------- 코드 하이라이트 (Prism 토큰, VS Code Light+/Dark+ 색) ---------- */
.token.comment,
.token.prolog,
.token.doctype,
.token.cdata {
	color: var(--tok-comment);
	font-style: italic;
}

.token.keyword,
.token.boolean,
.token.builtin,
.token.important {
	color: var(--tok-keyword);
}

.token.keyword.control-flow,
.token.atrule {
	color: var(--tok-control);
}

.token.string,
.token.char,
.token.attr-value,
.token.regex,
.token.template-string {
	color: var(--tok-string);
}

.token.number,
.token.constant,
.token.symbol {
	color: var(--tok-number);
}

.token.function,
.token.method {
	color: var(--tok-function);
}

.token.class-name,
.token.tag,
.token.selector,
.token.annotation {
	color: var(--tok-class);
}

.token.variable,
.token.property,
.token.attr-name,
.token.parameter {
	color: var(--tok-variable);
}

.token.operator,
.token.punctuation {
	color: var(--tok-punct);
}
